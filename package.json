{
  "name": "yijian-translator",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:pages": "node build.mjs --pages",
    "publish:pages": "npm run build:pages && node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "marked": "18.1.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
